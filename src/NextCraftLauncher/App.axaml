<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NextCraftLauncher.App"
             xmlns:local="using:NextCraftLauncher"
             xmlns:controls="using:NextCraftLauncher.Controls"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>


    <!--
        颜色不在这里定义：见 Theme/Palette.cs，启动时由 Palette.Register 注册成
        应用资源（可运行时换色）。这里只保留与颜色无关的样式。
    -->

    <Application.Styles>
        <FluentTheme />

        <!--
            界面图标：形状来自 Assets/Icons/Ui/*.svg（由 Icons/UiIcons 按文件名读取），
            线宽、尺寸、颜色只在这里定义一次，图标本身不带任何样式。
            加图标 = 丢一个 SVG 进目录 + 写 Icon="名字"。
        -->
        <Style Selector="controls|IconView">
            <Setter Property="IconSize" Value="12" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="controls|IconView.small">
            <Setter Property="IconSize" Value="10" />
        </Style>
        <Style Selector="controls|IconView.large">
            <Setter Property="IconSize" Value="16" />
        </Style>

        <!-- 极细分割线，替代卡片边框 -->
        <Style Selector="Border.hline">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>

        <!-- 任务卡片：任务页里每个下载任务一张，后续新增任务沿用同一外观 -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource TaskCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TaskCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="TextBlock.micro">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeMicro}" />
            <Setter Property="Opacity" Value="{DynamicResource TextOpacityTertiary}" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Opacity" Value="{DynamicResource TextOpacitySecondary}" />
        </Style>

        <!-- 分组眉标：比正文小一号、加宽字距 -->
        <Style Selector="TextBlock.group">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightEmphasis}" />
            <Setter Property="LetterSpacing" Value="{DynamicResource LetterSpacingGroup}" />
            <Setter Property="Opacity" Value="{DynamicResource TextOpacitySecondary}" />
        </Style>

        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightEmphasis}" />
        </Style>

        <Style Selector="TextBlock.subsection">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightEmphasis}" />
        </Style>

        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightEmphasis}" />
        </Style>

        <Style Selector="TextBlock.display">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightEmphasis}" />
        </Style>

        <Style Selector="TextBlock.body">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        </Style>

        <Style Selector="TextBlock.bodyStrong">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightEmphasis}" />
        </Style>

        <Style Selector="TextBlock.bodyMuted">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
            <Setter Property="Opacity" Value="{DynamicResource TextOpacityLabel}" />
        </Style>

        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
            <Setter Property="Opacity" Value="{DynamicResource TextOpacitySecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
            <Setter Property="Opacity" Value="{DynamicResource TextOpacityLabel}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.code">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
        </Style>

        <Style Selector="TextBlock.brand">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            <Setter Property="LetterSpacing" Value="{DynamicResource LetterSpacingBrand}" />
        </Style>

        <Style Selector="TextBlock.deviceCode">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeDeviceCode}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            <Setter Property="LetterSpacing" Value="{DynamicResource LetterSpacingBrand}" />
        </Style>

        <Style Selector="TextBlock.brandSplash">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBrandSplash}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeightStrong}" />
            <Setter Property="LetterSpacing" Value="{DynamicResource LetterSpacingBrand}" />
        </Style>

        <!-- 进度条用主题强调色，和按钮、选中态保持一致；数值变化做缓动 -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentFillBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Value" Duration="0:0:0.35" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.toolbar">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBox.toolbar">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ComboBox.toolbar">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 统一按钮外观 -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 侧边栏导航按钮 -->
        <Style Selector="Button.side">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.side.selected">
            <Setter Property="Background" Value="{DynamicResource SoftButtonBrush}" />
        </Style>
        <!-- 悬浮只在未选中项上生效：选中项悬停时保持选中色，选中身份不会丢 -->
        <Style Selector="Button.side:pointerover:not(.selected) /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftButtonHoverBrush}" />
        </Style>
        <!-- 选中项悬停时也要显式挡住主题自己的悬停底色 -->
        <Style Selector="Button.side.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftButtonBrush}" />
        </Style>
        <Style Selector="Button.side:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftButtonPressedBrush}" />
        </Style>

        <!-- 次按钮：沿用主题自带的灰底，无边框 -->
        <Style Selector="Button.soft">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.soft:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.soft:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Opacity" Value="0.78" />
        </Style>

        <!-- 下拉按钮与普通按钮保持一致的外观 -->
        <Style Selector="DropDownButton">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="DropDownButton.soft">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnFillTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnFillTextBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnFillTextBrush}" />
        </Style>

        <!-- 强调色描边按钮：透明底 + 强调色边框与文字 -->
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.outline:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnFillTextBrush}" />
        </Style>
        <Style Selector="Button.outline:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnFillTextBrush}" />
        </Style>

        <!-- 不能启动时按钮变灰，但仍可点击（点击后用 notice 卡片说明原因） -->
        <Style Selector="Button.primary.disabled">
            <Setter Property="Background" Value="{DynamicResource MutedFillBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="Button.primary.disabled:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MutedFillHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="Button.primary.disabled:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MutedFillPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource ErrorFillBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnFillTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ErrorFillHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnFillTextBrush}" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ErrorFillPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnFillTextBrush}" />
        </Style>

        <!-- 列表项使用圆角选中矩形 -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- 去掉 Fluent 默认的直角焦点框，否则它会贴着文字形成一个小矩形 -->
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Name="PART_Root"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <!-- 主题会给 PART_ContentPresenter 上色，且是直角；这里直接定为透明，高亮统一由 PART_Root 绘制 -->
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Background="Transparent"
                                              CornerRadius="8" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource PanelFillHoverBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource PanelFillBrush}" />
        </Style>

        <!--
            主题会按 :pointerover / :pressed / :selected 给内层 ContentPresenter 上色，
            且优先级是 StyleTrigger，高于模板里的 Background 值。必须用同样的伪类显式
            覆盖成透明，否则圆角外框里面会多出一块贴近文字的矩形。
        -->
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected:not(:focus) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- 下拉选项同样使用圆角选中矩形 -->
        <Style Selector="ComboBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Name="PART_Root"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <!-- 同上：阻止 ComboBoxItem 主题的直角高亮透出来 -->
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Background="Transparent"
                                              CornerRadius="6" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource PanelFillHoverBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource PanelFillBrush}" />
        </Style>

        <!-- 同上：ComboBoxItem 主题的选择器不限制部件名，所有 ContentPresenter 都会被上色 -->
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ComboBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ComboBoxItem:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ComboBoxItem:selected:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ComboBoxItem:selected:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>
