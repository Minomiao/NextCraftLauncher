<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NextCraftLauncher.Controls.MessageCard">

    <!-- 通用提示卡片：遮罩 + 卡片。外观由 Kind 预设决定，文字与显隐由属性控制。 -->
    <Border x:Name="Mask" Background="#66000000" IsVisible="False">
        <Border Width="480"
                Padding="24"
                CornerRadius="12"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="12">
                <TextBlock x:Name="TitleText"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="MessageText"
                           FontSize="12.5"
                           Opacity="0.75"
                           TextWrapping="Wrap"
                           IsVisible="False" />

                <TextBlock x:Name="AdviceText"
                           FontSize="12"
                           Opacity="0.55"
                           TextWrapping="Wrap"
                           IsVisible="False" />

                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Right">
                    <Button x:Name="CloseButton"
                            Content="确定"
                            Height="32"
                            Padding="14,0"
                            Click="OnCloseClick" />
                    <Button x:Name="LogButton"
                            Content="打开 log 文件"
                            Height="32"
                            Padding="14,0"
                            IsVisible="False"
                            Click="OnOpenLogClick" />
                    <Button x:Name="ExportButton"
                            Classes="primary"
                            Content="导出错误报告"
                            Height="32"
                            Padding="14,0"
                            IsVisible="False"
                            Click="OnExportClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
