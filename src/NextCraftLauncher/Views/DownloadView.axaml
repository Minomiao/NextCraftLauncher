<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NextCraftLauncher.ViewModels"
             xmlns:java="using:NextCraftLauncher.Core.Java"
             xmlns:controls="using:NextCraftLauncher.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="620"
             x:Class="NextCraftLauncher.Views.DownloadView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="Button.versionRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.versionRow.selected">
            <Setter Property="Background" Value="{DynamicResource PanelFillBrush}" />
        </Style>
        <Style Selector="Button.versionRow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelFillHoverBrush}" />
        </Style>
        <Style Selector="Button.versionRow:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelFillPressedBrush}" />
        </Style>

        <!-- 加载器分组行只有图标和一行标题，内边距取 8 才能上/左/下等距 -->
        <Style Selector="Button.versionRow.loaderHeader">
            <Setter Property="Padding" Value="8" />
        </Style>

        <!-- 任务卡片里的失败信息用错误色，与普通进度文字区分 -->
        <Style Selector="TextBlock.meta.failed">
            <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- 侧边栏的合计进度：没有任务时整体置灰 -->
        <Style Selector="StackPanel.taskProgress.idle">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- 列表只负责虚拟化滚动，选中高亮由行内按钮控制 -->
        <Style Selector="ListBox.versionList ListBoxItem:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.versionList ListBoxItem:selected /template/ Border#PART_Root">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- 版本条：一格一条游戏版本，选中时用胶囊色 -->
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chip.selected">
            <Setter Property="Background" Value="{DynamicResource SoftButtonBrush}" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftButtonHoverBrush}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Button.chip.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SoftButtonBrush}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <!-- 翻页按钮：无边框、无底色，只保留图标 -->
        <Style Selector="Button.pager">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid>

        <!-- ================= 侧边栏视图 ================= -->
        <Grid ColumnDefinitions="Auto,*"
              IsVisible="{Binding !IsDownloadRunningSelected}">

            <!-- 左侧边栏：进入次级页面后收起，把宽度让给内容 -->
            <Grid Width="176"
                  Margin="0,0,16,0"
                  RowDefinitions="*,Auto"
                  IsVisible="{Binding !IsSubPageOpen}">
                <StackPanel Spacing="2" VerticalAlignment="Top" Margin="0,2,0,0">
                    <Button Classes="side"
                            Classes.selected="{Binding IsDownloadVersionsSelected}"
                            Content="游戏"
                            Command="{Binding ShowDownloadVersionsCommand}" />
                    <Button Classes="side"
                            Classes.selected="{Binding IsDownloadModsSelected}"
                            Content="Mod"
                            Command="{Binding ShowDownloadModsCommand}" />
                    <Button Classes="side"
                            Classes.selected="{Binding IsDownloadResourcePacksSelected}"
                            Content="材质包"
                            Command="{Binding ShowDownloadResourcePacksCommand}" />
                    <Button Classes="side"
                            Classes.selected="{Binding IsDownloadJavaSelected}"
                            Content="Java"
                            Command="{Binding ShowDownloadJavaCommand}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="8">
                    <!-- 所有任务的合计进度；无任务时只剩置灰的空进度条 -->
                    <StackPanel Spacing="4"
                                Classes="taskProgress"
                                Classes.idle="{Binding !HasActiveDownloads}">
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasActiveDownloads}">
                            <TextBlock Text="下载进度"
                                       FontSize="12"
                                       Opacity="0.72"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding OverallDownloadPercentText}"
                                       FontSize="12" />
                        </Grid>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding OverallDownloadPercent}"
                                     MinWidth="0"
                                     HorizontalAlignment="Stretch"
                                     Height="4" />
                    </StackPanel>

                    <Button Classes="side"
                            Content="任务"
                            Command="{Binding ShowDownloadRunningCommand}" />
                </StackPanel>
            </Grid>


            <Grid Grid.Column="1" RowDefinitions="Auto,*">

                <!-- 游戏目录：只在游戏版本页显示 -->
                <TextBlock Text="{Binding MinecraftDirectory}"
                           Margin="0,0,0,14"
                           IsVisible="{Binding IsDownloadVersionsSelected}"
                           FontSize="11"
                           Opacity="0.56"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding MinecraftDirectory}" />

                <Grid Grid.Row="1">

                    <!-- 游戏版本：列表 → 版本详情 -->
                    <Grid IsVisible="{Binding IsDownloadVersionsSelected}">

                        <!-- 版本列表 -->
                        <Grid RowDefinitions="Auto,*" RowSpacing="10"
                              IsVisible="{Binding !IsRemoteVersionDetailOpen}">

                            <Grid ColumnDefinitions="*,120,Auto" ColumnSpacing="8">
                                <TextBox Classes="toolbar"
                                         Text="{Binding RemoteVersionSearch}"
                                         PlaceholderText="搜索版本号…" />
                                <ComboBox Grid.Column="1"
                                          Classes="toolbar"
                                          ItemsSource="{Binding RemoteVersionTypes}"
                                          SelectedItem="{Binding RemoteVersionType}"
                                          HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2"
                                        Classes="toolbar soft"
                                        Content="刷新列表"
                                        Command="{Binding LoadRemoteVersionsCommand}"
                                        IsEnabled="{Binding !IsRemoteVersionsLoading}" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <ListBox Classes="versionList"
                                         ItemsSource="{Binding RemoteVersionRows}"
                                         Background="Transparent"
                                         Padding="0,0,14,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RemoteVersionListRowViewModel">
                                            <Grid>
                                                <Grid IsVisible="{Binding IsHeader}"
                                                      ColumnDefinitions="*,Auto"
                                                      Margin="0,10,0,4">
                                                    <TextBlock Text="{Binding GroupTitle}"
                                                               Classes="section"
                                                               FontSize="13" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding GroupCountText}"
                                                               FontSize="11"
                                                               Opacity="0.56"
                                                               VerticalAlignment="Center" />
                                                </Grid>

                                                <Button IsVisible="{Binding IsVersion}"
                                                        Classes="versionRow"
                                                        Classes.selected="{Binding Version.IsSelected}"
                                                        Command="{Binding Version.SelectCommand}">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <controls:BlockIcon Grid.Column="0"
                                                                            Width="30"
                                                                            Height="30"
                                                                            AlignToOutline="True"
                                                                            VerticalAlignment="Center"
                                                                            Block="{Binding Version.IconName}" />
                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                            <TextBlock Text="{Binding Version.Id}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Version.Subtitle}"
                                                                       FontSize="11"
                                                                       Opacity="0.56" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="正在获取版本清单..."
                                           IsVisible="{Binding ShowRemoteVersionsLoading}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.56" />
                            </Grid>
                        </Grid>

                        <!-- 版本详情：加载器版本 + 原版下载 -->
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10"
                              IsVisible="{Binding IsRemoteVersionDetailOpen}">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <controls:BlockIcon Grid.Column="0"
                                                    Width="64"
                                                    Height="64"
                                                    VerticalAlignment="Center"
                                                    Block="{Binding DownloadIconName}" />
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedRemoteVersion.Id}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedRemoteVersion.Subtitle}"
                                               FontSize="11"
                                               Opacity="0.56"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" RowDefinitions="*">
                                <!-- 与游戏版本列表同构：分组标题行 + 版本行，共用 versionRow 样式 -->
                                <ListBox
                                         Classes="versionList"
                                         ItemsSource="{Binding LoaderVersionRows}"
                                         Background="Transparent"
                                         Padding="0,0,14,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LoaderVersionListRowViewModel">
                                            <Grid>
                                                <Button IsVisible="{Binding IsHeader}"
                                                        Classes="versionRow loaderHeader"
                                                        Command="{Binding ToggleCommand}"
                                                        ToolTip.Tip="{Binding Error}">
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                                                        <TextBlock Text="{Binding Chevron}"
                                                                   FontSize="10"
                                                                   Width="10"
                                                                   Opacity="0.4"
                                                                   VerticalAlignment="Center" />
                                                        <controls:BlockIcon Grid.Column="1"
                                                                            Width="22"
                                                                            Height="22"
                                                                            AlignToOutline="True"
                                                                            VerticalAlignment="Center"
                                                                            Block="{Binding HeaderIcon}" />
                                                        <StackPanel Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    Spacing="6"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Classes="section"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding SelectionText}"
                                                                       FontSize="12"
                                                                       Opacity="0.72"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding HasSelection}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Status}"
                                                                   FontSize="11"
                                                                   Opacity="0.56"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <Button IsVisible="{Binding IsVersion}"
                                                        Classes="versionRow"
                                                        Classes.selected="{Binding Item.IsSelected}"
                                                        Command="{Binding Item.SelectCommand}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding Version}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Tag}"
                                                                   IsVisible="{Binding HasTag}"
                                                                   FontSize="11"
                                                                   Opacity="0.56"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <TextBlock IsVisible="{Binding IsEmpty}"
                                                           Text="{Binding Text}"
                                                           FontSize="12"
                                                           Opacity="0.56"
                                                           Margin="8,5"
                                                           TextWrapping="Wrap"
                                                           ToolTip.Tip="{Binding Error}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="版本名" Classes="fieldLabel" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Classes="toolbar"
                                             Text="{Binding VersionName}"
                                             PlaceholderText="新版本的名称" />
                                    <Button Grid.Column="2"
                                            Classes="soft"
                                            Content="默认"
                                            Command="{Binding ResetVersionNameCommand}"
                                            Height="32"
                                            Padding="12,0"
                                            ToolTip.Tip="恢复为「版本-加载器 版本」" />
                                </Grid>

                                <Button Grid.Row="1"
                                        Classes="primary"
                                        Classes.disabled="{Binding HasDuplicateVersionName}"
                                        Content="下载选中版本"
                                        Command="{Binding DownloadSelectedCommand}"
                                        IsEnabled="{Binding CanDownloadSelected}"
                                        HorizontalAlignment="Right"
                                        Height="32"
                                        Padding="18,0" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Mod / 材质包下载 -->
                    <Grid IsVisible="{Binding IsDownloadContentSelected}">

                        <!-- 搜索结果 -->
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10"
                              IsVisible="{Binding !IsModDetailOpen}">

                            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Classes="toolbar"
                                             Text="{Binding ModSearchText}"
                                             PlaceholderText="{Binding ModSearchPlaceholder}"
                                             KeyDown="OnModSearchKeyDown" />
                                    <Button Grid.Column="1"
                                            Classes="toolbar primary"
                                            Content="搜索"
                                            Command="{Binding SearchModsCommand}"
                                            IsEnabled="{Binding !IsModsLoading}" />
                                </Grid>

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="Auto,*,Auto,*,Auto,Auto"
                                      ColumnSpacing="8">
                                    <TextBlock Text="来源" Classes="fieldLabel" />
                                    <ComboBox Grid.Column="1"
                                              Classes="toolbar"
                                              ItemsSource="{Binding ModSources}"
                                              SelectedIndex="{Binding SelectedModSourceIndex}"
                                              HorizontalAlignment="Stretch" />
                                    <TextBlock Grid.Column="2" Text="版本" Classes="fieldLabel" />
                                    <ComboBox Grid.Column="3"
                                              Classes="toolbar"
                                              ItemsSource="{Binding ModGameVersions}"
                                              SelectedIndex="{Binding SelectedModGameVersionIndex}"
                                              HorizontalAlignment="Stretch" />
                                    <TextBlock Grid.Column="4"
                                               Text="加载器"
                                               Classes="fieldLabel"
                                               IsVisible="{Binding IsModSearchLoaderVisible}" />
                                    <ComboBox Grid.Column="5"
                                              Classes="toolbar"
                                              Width="140"
                                              ItemsSource="{Binding ModLoaderOptions}"
                                              SelectedIndex="{Binding SelectedModLoaderIndex}"
                                              IsVisible="{Binding IsModSearchLoaderVisible}" />
                                </Grid>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding ModStatus}"
                                       Classes="meta" />

                            <ScrollViewer Grid.Row="2"
                                          x:Name="ModResultsScroll"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="6" Margin="0,0,10,0">
                                    <ItemsControl ItemsSource="{Binding ModProjects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ModProjectItemViewModel">
                                                <Button Classes="versionRow"
                                                        Command="{Binding SelectCommand}">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <controls:RemoteImage Width="44"
                                                                              Height="44"
                                                                              VerticalAlignment="Top"
                                                                              SourceUrl="{Binding IconUrl}"
                                                                              CacheKey="{Binding IconKey}" />
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Subtitle}"
                                                                       FontSize="11"
                                                                       Opacity="0.56" />
                                                            <TextBlock Text="{Binding Description}"
                                                                       FontSize="11"
                                                                       Opacity="0.56"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 翻页：首/末页不显示对应按钮，不留置灰箭头 -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="12"
                                                HorizontalAlignment="Center"
                                                Margin="0,8,0,4"
                                                IsVisible="{Binding ShowModPager}">
                                        <Button Classes="pager"
                                                Content="上一页"
                                                Command="{Binding GoPreviousModPageCommand}"
                                                IsVisible="{Binding CanGoPreviousModPage}" />

                                        <TextBlock Text="{Binding ModPageText}"
                                                   Classes="meta"
                                                   VerticalAlignment="Center" />

                                        <Button Classes="pager"
                                                Content="下一页"
                                                Command="{Binding GoNextModPageCommand}"
                                                IsVisible="{Binding CanGoNextModPage}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- 项目详情：版本列表 -->
                        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10"
                              IsVisible="{Binding IsModDetailOpen}">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <controls:RemoteImage Width="48"
                                                      Height="48"
                                                      VerticalAlignment="Top"
                                                      SourceUrl="{Binding SelectedModProject.IconUrl}"
                                                      CacheKey="{Binding SelectedModProject.IconKey}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding ModDetailTitle}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ModDetailDescription}"
                                               Classes="meta"
                                               MaxHeight="54"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding ModDetailStatus}"
                                       Classes="meta" />

                            <!-- 版本条：推荐 + 全部 + 该模组支持过的游戏版本，横向滚动 -->
                            <ScrollViewer Grid.Row="2"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          IsVisible="{Binding ShowModVersionFilters}">
                                <ItemsControl ItemsSource="{Binding ModVersionFilters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModVersionFilterViewModel">
                                            <Button Classes="chip"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Content="{Binding Name}"
                                                    Command="{Binding SelectCommand}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ListBox Grid.Row="3"
                                     Classes="versionList"
                                     ItemsSource="{Binding ModVersionRows}"
                                     Background="Transparent"
                                     Padding="0,0,14,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModVersionListRowViewModel">
                                        <Grid>
                                            <!-- 分组标题：加载器 · 发布类型，点击展开/收起 -->
                                            <Button IsVisible="{Binding IsHeader}"
                                                    Classes="versionRow loaderHeader"
                                                    Command="{Binding ToggleCommand}">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                    <TextBlock Text="{Binding Chevron}"
                                                               FontSize="10"
                                                               Width="10"
                                                               Opacity="0.4"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               Classes="section"
                                                               FontSize="13"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding CountText}"
                                                               FontSize="11"
                                                               Opacity="0.56"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>

                                            <!-- 文件行：一行，左侧版本名、右侧日期；点击选中后底部出现下载按钮 -->
                                            <Button IsVisible="{Binding IsVersion}"
                                                    Classes="versionRow"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Margin="16,0,0,0"
                                                    Command="{Binding SelectCommand}"
                                                    ToolTip.Tip="{Binding Version.Subtitle}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <TextBlock Text="{Binding Version.Title}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Version.DateText}"
                                                               FontSize="11"
                                                               Opacity="0.56"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 底部的下载栏：未选中时也显示，按钮置灰 -->
                            <Grid Grid.Row="4"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  Margin="16,2,14,0">
                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedModFileTitle}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedModFileFolder}"
                                               FontSize="11"
                                               Opacity="0.56"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding SelectedModFileFolder}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="primary"
                                        Content="下载"
                                        Height="32"
                                        Padding="18,0"
                                        IsEnabled="{Binding HasSelectedModFile}"
                                        Command="{Binding DownloadSelectedModFileCommand}" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Java 运行时 -->
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12"
                          IsVisible="{Binding IsDownloadJavaSelected}">

                        <StackPanel Spacing="12">
                            <TextBlock Text="下载所需 Java" Classes="section" />

                            <Grid ColumnDefinitions="76,*"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="8">
                                <TextBlock Text="目标版本" Classes="fieldLabel" />
                                <ComboBox Grid.Column="1"
                                          Classes="toolbar"
                                          ItemsSource="{Binding Versions}"
                                          SelectedItem="{Binding SelectedVersion}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VersionItemViewModel">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Id}" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.56" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Text="所需 Java" Classes="fieldLabel" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding RequiredJavaDescription}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Row="2" Text="当前 Java" Classes="fieldLabel" />
                                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ComboBox Classes="toolbar"
                                              ItemsSource="{Binding JavaRuntimes}"
                                              SelectedItem="{Binding SelectedJava}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="java:JavaRuntime">
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" Classes="toolbar soft" Content="浏览" Click="OnBrowseJavaClick" />
                                </Grid>
                            </Grid>

                            <Button Content="下载 Java"
                                    Command="{Binding DownloadJavaCommand}"
                                    IsEnabled="{Binding CanDownloadJava}"
                                    Classes="primary"
                                    Height="34"
                                    Padding="18,0"
                                    HorizontalAlignment="Left" />
                        </StackPanel>

                        <Border Grid.Row="1" Classes="hline" />

                        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="全部 Java 运行时" Classes="section" />
                                <Button Grid.Column="1"
                                        Classes="toolbar soft"
                                        Content="刷新列表"
                                        Command="{Binding LoadJavaRuntimesCommand}"
                                        IsEnabled="{Binding !IsJavaRuntimeCatalogLoading}"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding JavaRuntimeCatalogStatus}"
                                       IsVisible="{Binding !IsJavaRuntimeCatalogFailed}"
                                       Classes="meta" />

                            <Grid Grid.Row="2">
                                <ListBox ItemsSource="{Binding AvailableJavaRuntimes}"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RemoteJavaRuntimeItemViewModel">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="2,5">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{Binding ComponentName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.56" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="已安装"
                                                           FontSize="11"
                                                           Opacity="0.56"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding IsInstalled}" />
                                                <Button Grid.Column="2"
                                                        Classes="soft"
                                                        Content="下载"
                                                        Command="{Binding DownloadCommand}"
                                                        IsEnabled="{Binding !IsInstalled}"
                                                        Height="26"
                                                        Padding="12,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="正在获取 Java 运行时列表..."
                                           IsVisible="{Binding ShowJavaRuntimeCatalogLoading}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.56" />
                                <TextBlock Text="无法获取 Java 运行时列表"
                                           IsVisible="{Binding IsJavaRuntimeCatalogFailed}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.56" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= 任务独立视图 ================= -->
        <Grid ColumnDefinitions="180,1,*" ColumnSpacing="20"
              IsVisible="{Binding IsDownloadRunningSelected}">

            <!-- 左列：统计，分割线不再被按钮行截断 -->
            <Grid>
                <StackPanel VerticalAlignment="Center" Spacing="32">
                    <StackPanel Spacing="6">
                        <TextBlock Text="总进度"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />
                        <Border Height="2"
                                Margin="6,0"
                                Background="{DynamicResource AccentFillBrush}" />
                        <TextBlock Text="{Binding OverallDownloadPercentText}"
                                   FontSize="22"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="下载速度"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />
                        <Border Height="2"
                                Margin="6,0"
                                Background="{DynamicResource AccentFillBrush}" />
                        <TextBlock Text="{Binding CurrentDownloadSpeedText}"
                                   FontSize="22"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="剩余文件"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />
                        <Border Height="2"
                                Margin="6,0"
                                Background="{DynamicResource AccentFillBrush}" />
                        <TextBlock Text="{Binding RemainingFilesCount}"
                                   FontSize="22"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>


            <!-- 任务列表：每个下载/安装任务一张卡片，可同时存在多个 -->
            <Grid Grid.Column="2">
                <TextBlock Text="没有正在进行的下载"
                           IsVisible="{Binding !HasDownloadTasks}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.4" />

                <ScrollViewer IsVisible="{Binding HasDownloadTasks}"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DownloadTasks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadTaskViewModel">
                                <Border Classes="card">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1"
                                                    Classes="caption"
                                                    ToolTip.Tip="取消"
                                                    IsVisible="{Binding IsRunning}"
                                                    Command="{Binding CancelCommand}">
                                                <controls:IconView Icon="close" />
                                            </Button>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Steps}" IsVisible="{Binding HasSteps}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DownloadTaskStepViewModel">
                                                    <Grid ColumnDefinitions="44,*">
                                                        <TextBlock Text="✓"
                                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                                   IsVisible="{Binding IsDone}" />
                                                        <TextBlock Text="{Binding Detail}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                                   IsVisible="{Binding IsActive}" />
                                                        <TextBlock Text="·"
                                                                   Opacity="0.4"
                                                                   IsVisible="{Binding IsPending}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding Percent}"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     Height="6" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   Classes="meta"
                                                   Classes.failed="{Binding IsFailed}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
