<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NextCraftLauncher.ViewModels"
             xmlns:controls="using:NextCraftLauncher.Controls"
             xmlns:java="using:NextCraftLauncher.Core.Java"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
             x:Class="NextCraftLauncher.Views.LaunchView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- 版本列表里每行的小按钮 -->
        <!-- 默认完全隐藏（含文字）：整行悬浮或选中时才淡入 -->
        <Style Selector="Button.rowAction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem:pointerover Button.rowAction">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBoxItem:selected Button.rowAction">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- 整行被高亮（悬浮 / 选中）时才露出按钮底色 -->
        <Style Selector="ListBoxItem:pointerover Button.rowAction /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowActionBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBoxItem:selected Button.rowAction /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowActionBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- 按钮自己的悬浮 / 按下比行高亮再深一档 -->
        <Style Selector="Button.rowAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowActionBackgroundHoverBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.rowAction:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowActionBackgroundPressedBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.rowAction.remove">
            <Setter Property="Foreground" Value="#D13438" />
        </Style>

        <!-- 账号类型切换（离线 / 正版） -->
        <Style Selector="Button.accountTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="20,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.accountTab.selected">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- 游戏名输入框：只用一条下划线，不要整个框 -->
        <Style Selector="TextBox.nameInput">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="0,0,0,2" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.nameInput /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TextBox.nameInput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        </Style>
        <Style Selector="TextBox.nameInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="176,1,*" ColumnSpacing="16">

        <!-- 左侧边栏 -->
        <StackPanel Spacing="2" VerticalAlignment="Top" Margin="0,2,0,0">
            <Button Classes="side"
                    Classes.selected="{Binding IsStartSectionSelected}"
                    Content="启动"
                    Command="{Binding ShowStartSectionCommand}" />
            <Button Classes="side"
                    Classes.selected="{Binding IsVersionsSectionSelected}"
                    Content="版本"
                    Command="{Binding ShowVersionsSectionCommand}" />
        </StackPanel>

        <Border Grid.Column="1" Classes="vline" />

        <Grid Grid.Column="2">

            <!-- 启动 -->
            <Grid IsVisible="{Binding IsStartSectionSelected}">

                <StackPanel Spacing="12"
                            MaxWidth="640"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="当前版本"
                                   FontSize="12"
                                   Opacity="0.55"
                                   HorizontalAlignment="Center" />

                        <!-- 实验：主界面的大版本显示做成无容器的弧形轮播，一次一页 -->
                        <controls:ArcCarousel ItemsSource="{Binding Versions}"
                                              SelectedItem="{Binding SelectedVersion}"
                                              Width="640"
                                              Height="104">
                            <controls:ArcCarousel.ItemTemplate>
                                <DataTemplate x:DataType="vm:VersionItemViewModel">
                                    <StackPanel Spacing="2" MaxWidth="440">
                                        <TextBlock Text="{Binding Id}"
                                                   FontSize="{Binding TitleFontSize}"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="13"
                                                   Opacity="0.6"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </controls:ArcCarousel.ItemTemplate>
                        </controls:ArcCarousel>
                        <TextBlock Text="{Binding CurrentJavaName}"
                                   FontSize="12"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- 账号：离线游戏名输入框保持原来的位置；正版时名字与按钮在同一行居中 -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,6">
                            <!-- 宽度与启动按钮一致，高度为其 2/3，内容居中 -->
                            <TextBox Classes="nameInput"
                                     Width="240"
                                     Height="32"
                                     Text="{Binding PlayerName}"
                                     IsVisible="{Binding IsOfflineAccount}" />

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsMicrosoftAccount}">
                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AccountDisplayName}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AccountSubtitle}"
                                               FontSize="11"
                                               Opacity="0.55"
                                               HorizontalAlignment="Center"
                                               IsVisible="{Binding HasMicrosoftAccount}" />
                                </StackPanel>

                                <Button Classes="toolbar soft"
                                        Content="登录"
                                        Command="{Binding LoginMicrosoftCommand}"
                                        IsVisible="{Binding !HasMicrosoftAccount}" />
                                <Button Classes="toolbar soft"
                                        Content="切换账号"
                                        Command="{Binding LoginMicrosoftCommand}"
                                        IsVisible="{Binding HasMicrosoftAccount}" />
                                <Button Classes="toolbar soft"
                                        Content="退出"
                                        Command="{Binding LogoutMicrosoftCommand}"
                                        IsVisible="{Binding HasMicrosoftAccount}" />
                            </StackPanel>
                        </StackPanel>

                        <Button Content="启动"
                                Command="{Binding LaunchCommand}"
                                Classes="primary"
                                Classes.disabled="{Binding !CanLaunch}"
                                ToolTip.Tip="{Binding LaunchWarning}"
                                Width="240"
                                Height="48"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0" />
                </StackPanel>

                <!-- 顶部账号切换：叠加在原有布局上方，不影响中间内容的居中 -->
                <StackPanel VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4"
                            Margin="0,6,0,0">
                    <Button Classes="accountTab"
                            Classes.selected="{Binding IsMicrosoftAccount}"
                            Content="正版"
                            Command="{Binding UseMicrosoftAccountCommand}" />
                    <Button Classes="accountTab"
                            Classes.selected="{Binding IsOfflineAccount}"
                            Content="离线"
                            Command="{Binding UseOfflineAccountCommand}" />
                </StackPanel>

                <!-- 正版登录 -->
                <Border IsVisible="{Binding IsLoginDialogOpen}"
                        Background="#33000000">
                    <Border Width="420"
                            Padding="24"
                            CornerRadius="12"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel Spacing="12">
                            <TextBlock Text="正版登录" FontSize="18" FontWeight="SemiBold" />

                            <TextBlock Text="{Binding LoginStatusText}"
                                       FontSize="13"
                                       Opacity="0.75"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding LoginUserCode}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       LetterSpacing="2"
                                       HorizontalAlignment="Center" />

                            <TextBlock Text="{Binding LoginVerificationUri}"
                                       FontSize="12"
                                       Opacity="0.6"
                                       HorizontalAlignment="Center" />

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Right">
                                <Button Content="复制代码"
                                        Height="32"
                                        Padding="14,0"
                                        Click="OnCopyLoginCodeClick" />
                                <Button Content="打开链接"
                                        Height="32"
                                        Padding="14,0"
                                        Click="OnOpenLoginLinkClick" />
                                <Button Content="取消"
                                        Height="32"
                                        Padding="14,0"
                                        Command="{Binding CancelMicrosoftLoginCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- 版本：列表页与详情页二选一 -->
            <Grid IsVisible="{Binding IsVersionsSectionSelected}">
                <Grid RowDefinitions="Auto,*" RowSpacing="12" IsVisible="{Binding !IsVersionDetailOpen}">

                    <!-- 文件夹下拉 + 重新扫描 + 导入 -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <ComboBox ItemsSource="{Binding GameFolders}"
                                  SelectedItem="{Binding SelectedGameFolder}"
                                  HorizontalAlignment="Stretch"
                                  MinHeight="34"
                                  Padding="8,1"
                                  ToolTip.Tip="{Binding SelectedGameFolder.Path}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameFolderItemViewModel">
                                    <StackPanel Spacing="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}"
                                                   FontSize="10"
                                                   Opacity="0.55"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1"
                                Classes="soft"
                                Content="重新扫描"
                                Height="34"
                                Padding="12,0"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding !IsBusy}" />

                        <DropDownButton Grid.Column="2"
                                        Classes="soft"
                                        Content="导入"
                                        Height="34"
                                        Padding="14,0"
                                        IsEnabled="{Binding !IsBusy}">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="添加已有文件夹…" Click="OnAddGameFolderClick" />
                                    <MenuItem Header="导入 PCL 启动器 (.exe)…" Click="OnChoosePclExecutableClick" />
                                    <MenuItem Header="导入 PCL 文件夹 / 游戏目录…" Click="OnChoosePclFolderClick" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!-- 本地版本列表（占据整个区域） -->
                    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="本地版本" Classes="section" FontSize="13" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding VersionsCountText}"
                                       FontSize="11"
                                       Opacity="0.6"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Versions}"
                                 SelectedItem="{Binding SelectedVersion}"
                                 Background="Transparent"
                                 Padding="0,0,14,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:VersionItemViewModel">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="2,3">
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Id}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="11"
                                                       Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="2"
                                                    VerticalAlignment="Center">
                                            <Button Classes="rowAction"
                                                    Content="设置"
                                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).OpenVersionSettingsCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="rowAction remove"
                                                    Content="删除"
                                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).RequestVersionDeleteCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <!-- 版本设置：暂时只展示版本信息 -->
                <Grid RowDefinitions="Auto,*" RowSpacing="12" IsVisible="{Binding IsVersionDetailOpen}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Button Classes="soft"
                                Content="返回"
                                Height="30"
                                Padding="12,0"
                                FontSize="12"
                                Command="{Binding CloseVersionSettingsCommand}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedVersion.Id}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,12,0">
                        <TextBlock Text="{Binding VersionDetails}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
