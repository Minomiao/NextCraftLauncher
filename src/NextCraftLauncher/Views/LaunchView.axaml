<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NextCraftLauncher.ViewModels"
             xmlns:controls="using:NextCraftLauncher.Controls"
             xmlns:java="using:NextCraftLauncher.Core.Java"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
             x:Class="NextCraftLauncher.Views.LaunchView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- 版本列表里每行的小按钮 -->
        <!-- 默认完全隐藏（含文字）：整行悬浮或选中时才淡入 -->
        <Style Selector="Button.rowAction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem:pointerover Button.rowAction">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBoxItem:selected Button.rowAction">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- 整行被高亮（悬浮 / 选中）时才露出按钮底色 -->
        <Style Selector="ListBoxItem:pointerover Button.rowAction /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowActionBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBoxItem:selected Button.rowAction /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowActionBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- 按钮自己的悬浮 / 按下比行高亮再深一档 -->
        <Style Selector="Button.rowAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowActionBackgroundHoverBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.rowAction:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RowActionBackgroundPressedBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.rowAction.remove">
            <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
        </Style>

        <!-- 侧栏图标按钮：透明底，悬浮 / 按下才出现浅色块 -->
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelFillHoverBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.icon:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelFillPressedBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <!-- 扫描期间禁用时保持原样，不闪灰底 -->
        <Style Selector="Button.icon:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.icon:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- 文件夹列表里的操作行：和文件夹条目同样的尺寸与悬浮反馈 -->
        <Style Selector="Button.folderAction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.folderAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelFillHoverBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.folderAction:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelFillPressedBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <!-- 扫描期间禁用时保持原样，不闪灰底 -->
        <Style Selector="Button.folderAction:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.folderAction:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- 内联展开的导入选项：比文件夹行更轻的子项 -->
        <Style Selector="Button.importOption">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.importOption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelFillHoverBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.importOption:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelFillPressedBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- 账号类型切换（离线 / 正版） -->
        <Style Selector="Button.accountTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="20,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- 选中态只由共享高亮表达，按钮自身不出现任何色块（含按下） -->
        <Style Selector="Button.accountTab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.accountTab:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- 游戏名输入框：只用一条下划线，不要整个框 -->
        <Style Selector="TextBox.nameInput">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="0,0,0,2" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.nameInput /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TextBox.nameInput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        </Style>
        <Style Selector="TextBox.nameInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid>

            <!-- 启动 -->
            <Grid IsVisible="{Binding IsStartSectionSelected}">

                <StackPanel Spacing="12"
                            MaxWidth="1000"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                        <TextBlock Text="当前版本"
                                   Classes="meta"
                                   HorizontalAlignment="Center" />

                        <!-- 大版本显示：无容器的弧形轮播，一次一页 -->
                        <controls:ArcCarousel ItemsSource="{Binding Versions}"
                                              SelectedItem="{Binding SelectedVersion}"
                                              Height="104"
                                              HorizontalAlignment="Stretch">
                            <controls:ArcCarousel.ItemTemplate>
                                <DataTemplate x:DataType="vm:VersionItemViewModel">
                                    <StackPanel Spacing="2" MaxWidth="440">
                                        <TextBlock Text="{Binding Id}"
                                                   FontSize="{Binding TitleFontSize}"
                                                   FontWeight="{DynamicResource FontWeightStrong}"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Classes="bodyMuted"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </controls:ArcCarousel.ItemTemplate>
                        </controls:ArcCarousel>
                        <TextBlock Text="{Binding CurrentJavaName}"
                                   Classes="meta"
                                   TextWrapping="NoWrap"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- 账号：离线游戏名输入框保持原来的位置；正版时名字与按钮在同一行居中 -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,6">
                            <!-- 宽度与启动按钮一致，高度为其 2/3，内容居中 -->
                            <TextBox Classes="nameInput"
                                     Width="240"
                                     Height="32"
                                     Text="{Binding PlayerName}"
                                     IsVisible="{Binding IsOfflineAccount}" />

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsMicrosoftAccount}">
                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AccountDisplayName}"
                                               Classes="bodyStrong"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AccountSubtitle}"
                                               Classes="caption"
                                               HorizontalAlignment="Center"
                                               IsVisible="{Binding HasMicrosoftAccount}" />
                                </StackPanel>

                                <Button Classes="toolbar soft"
                                        Content="登录"
                                        Command="{Binding LoginMicrosoftCommand}"
                                        IsVisible="{Binding !HasMicrosoftAccount}" />
                                <Button Classes="toolbar soft"
                                        Content="切换账号"
                                        Command="{Binding LoginMicrosoftCommand}"
                                        IsVisible="{Binding HasMicrosoftAccount}" />
                                <Button Classes="toolbar soft"
                                        Content="退出"
                                        Command="{Binding LogoutMicrosoftCommand}"
                                        IsVisible="{Binding HasMicrosoftAccount}" />
                            </StackPanel>
                        </StackPanel>

                        <Button Content="启动"
                                Command="{Binding LaunchCommand}"
                                Classes="primary"
                                Classes.disabled="{Binding !CanLaunch}"
                                ToolTip.Tip="{Binding LaunchWarning}"
                                Width="240"
                                Height="48"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0" />

                        <!-- 版本选择 / 版本设置：强调色描边，与上面启动按钮同宽 -->
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8"
                              Width="240"
                              HorizontalAlignment="Center">
                            <Button Classes="outline"
                                    Content="版本选择"
                                    Height="34"
                                    FontSize="{DynamicResource FontSizeMeta}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ShowVersionsSectionCommand}" />
                            <Button Grid.Column="1"
                                    Classes="outline"
                                    Content="版本设置"
                                    Height="34"
                                    FontSize="{DynamicResource FontSizeMeta}"
                                    HorizontalAlignment="Stretch"
                                    ToolTip.Tip="设置当前版本"
                                    Command="{Binding OpenCurrentVersionSettingsCommand}" />
                        </Grid>
                </StackPanel>

                <!-- 顶部账号切换：共享高亮可按住拖动，与顶部导航一致 -->
                <Panel x:Name="AccountSwitch"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0">
                    <!-- 唯一的高亮：位置与宽度由代码驱动 -->
                    <Border x:Name="AccountPill"
                            CornerRadius="6"
                            Background="{DynamicResource SoftButtonBrush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False" />

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MicrosoftTab"
                                Classes="accountTab"
                                Classes.selected="{Binding IsMicrosoftAccount}"
                                Content="正版"
                                Command="{Binding UseMicrosoftAccountCommand}" />
                        <Button x:Name="OfflineTab"
                                Classes="accountTab"
                                Classes.selected="{Binding IsOfflineAccount}"
                                Content="离线"
                                Command="{Binding UseOfflineAccountCommand}" />
                    </StackPanel>
                </Panel>

                <!-- 正版登录 -->
                <Border IsVisible="{Binding IsLoginDialogOpen}"
                        Background="{DynamicResource OverlayMaskBrush}">
                    <Border Width="420"
                            Padding="24"
                            CornerRadius="12"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel Spacing="12">
                            <TextBlock Text="正版登录" Classes="title" />

                            <TextBlock Text="{Binding LoginStatusText}"
                                       Classes="bodyMuted"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding LoginUserCode}"
                                       Classes="deviceCode"
                                       HorizontalAlignment="Center" />

                            <TextBlock Text="{Binding LoginVerificationUri}"
                                       Classes="meta"
                                       HorizontalAlignment="Center" />

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Right">
                                <Button Content="复制代码"
                                        Height="32"
                                        Padding="14,0"
                                        Click="OnCopyLoginCodeClick" />
                                <Button Content="打开链接"
                                        Height="32"
                                        Padding="14,0"
                                        Click="OnOpenLoginLinkClick" />
                                <Button Content="取消"
                                        Height="32"
                                        Padding="14,0"
                                        Command="{Binding CancelMicrosoftLoginCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- 版本：列表页与详情页二选一 -->
            <Grid IsVisible="{Binding IsVersionsSectionSelected}">
                <Grid x:Name="VersionsListPage"
                      RowDefinitions="Auto,*" RowSpacing="12"
                      IsVisible="{Binding !IsVersionDetailOpen}">

                    <!-- 顶部标题 -->
                    <TextBlock Text="版本管理"
                               Classes="subsection"
                               VerticalAlignment="Center" />

                    <!-- 左侧：游戏文件夹；“本地版本”在右侧铺开 -->
                    <Grid Grid.Row="1" ColumnDefinitions="200,1,*" ColumnSpacing="16">
                        <Grid RowDefinitions="Auto,*" RowSpacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="游戏文件夹"
                                           Classes="caption"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Classes="icon"
                                        ToolTip.Tip="重新扫描"
                                        Command="{Binding RefreshCommand}"
                                        IsEnabled="{Binding !IsBusy}">
                                    <controls:IconView Icon="refresh" />
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="2" Margin="0,0,10,0">
                                    <ListBox x:Name="GameFoldersList"
                                             ItemsSource="{Binding GameFolders}"
                                             SelectedItem="{Binding SelectedGameFolder}"
                                             Background="Transparent"
                                             Padding="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GameFolderItemViewModel">
                                                <StackPanel Spacing="1" Margin="2,3" ToolTip.Tip="{Binding Path}">
                                                    <TextBlock Text="{Binding Name}"
                                                               Classes="bodyStrong"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Path}"
                                                               Classes="caption"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- 文件夹列表末尾：添加 / 导入 -->
                                    <StackPanel Spacing="1">
                                        <Button Classes="folderAction"
                                                ToolTip.Tip="添加或导入游戏文件夹"
                                                IsEnabled="{Binding !IsBusy}"
                                                Click="OnToggleImportMenuClick">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        Margin="2,0,0,0">
                                                <Border Width="16"
                                                        Height="16"
                                                        CornerRadius="8"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                        VerticalAlignment="Center">
                                                    <controls:IconView x:Name="AddFolderPlusIcon"
                                                                       Icon="plus"
                                                                       IconSize="8"
                                                                       StrokeThickness="1.25"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="添加游戏文件夹"
                                                           Classes="bodyStrong"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- 内联展开：三种导入方式 -->
                                        <StackPanel x:Name="ImportMenuPanel"
                                                    IsVisible="False"
                                                    Spacing="1"
                                                    Margin="24,0,0,0">
                                            <Button Classes="importOption"
                                                    ToolTip.Tip="选择一个已有的 .minecraft 文件夹"
                                                    Click="OnAddGameFolderClick">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <controls:IconView Icon="folder"
                                                                       IconSize="12"
                                                                       VerticalAlignment="Center" />
                                                    <TextBlock Text="选择已有文件夹"
                                                               Classes="body"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="importOption"
                                                    ToolTip.Tip="从 PCL2 启动器文件导入"
                                                    Click="OnChoosePclExecutableClick">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <controls:IconView Icon="pcl"
                                                                       VerticalAlignment="Center" />
                                                    <TextBlock Text="导入 PCL 启动器"
                                                               Classes="body"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="importOption"
                                                    ToolTip.Tip="从 PCL2 文件夹或游戏目录导入"
                                                    Click="OnChoosePclFolderClick">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <controls:IconView Icon="folder"
                                                                       IconSize="12"
                                                                       VerticalAlignment="Center" />
                                                    <TextBlock Text="导入 PCL 文件夹"
                                                               Classes="body"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>


                        <!-- 本地版本列表 -->
                        <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="本地版本" Classes="subsection" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding VersionsCountText}"
                                           Classes="caption"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <ListBox x:Name="LocalVersionsList"
                                     Grid.Row="1"
                                     ItemsSource="{Binding Versions}"
                                     SelectedItem="{Binding SelectedVersion}"
                                     Background="Transparent"
                                     Padding="0,0,14,0"
                                     PointerReleased="OnVersionSelectedByPointer">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VersionItemViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="3,3">
                                            <controls:BlockIcon Grid.Column="0"
                                                                Width="28"
                                                                Height="28"
                                                                AlignToOutline="True"
                                                                VerticalAlignment="Center"
                                                                Block="{Binding IconName}" />

                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Id}"
                                                           Classes="bodyStrong"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Classes="caption"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Spacing="2"
                                                        VerticalAlignment="Center">
                                                <Button Classes="rowAction"
                                                        Content="设置"
                                                        Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).OpenVersionSettingsCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Classes="rowAction remove"
                                                        Content="删除"
                                                        Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).RequestVersionDeleteCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 版本设置：左侧分栏，具体内容暂未实现；版本名显示在标题栏 -->
                <Grid IsVisible="{Binding IsVersionDetailOpen}"
                      ColumnDefinitions="176,1,*"
                      ColumnSpacing="16">
                    <StackPanel x:Name="VersionSettingsSideBar"
                                Spacing="2"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0">
                        <Button Classes="side"
                                Classes.selected="{Binding IsVersionSettingsSelected}"
                                Content="设置"
                                Command="{Binding ShowVersionSettingsCommand}" />
                        <Button Classes="side"
                                Classes.selected="{Binding IsVersionModsSelected}"
                                Content="Mod"
                                Command="{Binding ShowVersionModsCommand}" />
                        <Button Classes="side"
                                Classes.selected="{Binding IsVersionExportSelected}"
                                Content="导出"
                                Command="{Binding ShowVersionExportCommand}" />
                    </StackPanel>

                    <!-- 具体内容暂空 -->
                    <Grid Grid.Column="2" />
                </Grid>
            </Grid>
    </Grid>
</UserControl>
