<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NextCraftLauncher.ViewModels"
             xmlns:java="using:NextCraftLauncher.Core.Java"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
             x:Class="NextCraftLauncher.Views.LaunchView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- 账号类型切换（离线 / 正版） -->
        <Style Selector="Button.accountTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="20,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.accountTab.selected">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- 游戏名输入框：只用一条下划线，不要整个框 -->
        <Style Selector="TextBox.nameInput">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="0,0,0,2" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.nameInput /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TextBox.nameInput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        </Style>
        <Style Selector="TextBox.nameInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="176,1,*" ColumnSpacing="16">

        <!-- 左侧边栏 -->
        <StackPanel Spacing="2" VerticalAlignment="Top" Margin="0,2,0,0">
            <Button Classes="side"
                    Classes.selected="{Binding IsStartSectionSelected}"
                    Content="启动"
                    Command="{Binding ShowStartSectionCommand}" />
            <Button Classes="side"
                    Classes.selected="{Binding IsVersionsSectionSelected}"
                    Content="版本"
                    Command="{Binding ShowVersionsSectionCommand}" />
        </StackPanel>

        <Border Grid.Column="1" Classes="vline" />

        <Grid Grid.Column="2">

            <!-- 启动 -->
            <Grid IsVisible="{Binding IsStartSectionSelected}">

                <StackPanel Spacing="12"
                            MaxWidth="520"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="当前版本"
                                   FontSize="12"
                                   Opacity="0.55"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentVersionName}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentVersionSubtitle}"
                                   FontSize="13"
                                   Opacity="0.6"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentJavaName}"
                                   FontSize="12"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- 账号：离线游戏名输入框保持原来的位置 -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,6">
                            <!-- 宽度与启动按钮一致，高度为其 2/3，内容居中 -->
                            <TextBox Classes="nameInput"
                                     Width="240"
                                     Height="32"
                                     Text="{Binding PlayerName}"
                                     IsVisible="{Binding IsOfflineAccount}" />

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsMicrosoftAccount}">
                                <StackPanel Spacing="1"
                                            MinWidth="180"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AccountDisplayName}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AccountSubtitle}"
                                               FontSize="11"
                                               Opacity="0.55"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                                <Button Classes="toolbar soft"
                                        Content="登录"
                                        Command="{Binding LoginMicrosoftCommand}"
                                        IsVisible="{Binding !HasMicrosoftAccount}" />
                                <Button Classes="toolbar soft"
                                        Content="切换账号"
                                        Command="{Binding LoginMicrosoftCommand}"
                                        IsVisible="{Binding HasMicrosoftAccount}" />
                                <Button Classes="toolbar soft"
                                        Content="退出"
                                        Command="{Binding LogoutMicrosoftCommand}"
                                        IsVisible="{Binding HasMicrosoftAccount}" />
                            </StackPanel>
                        </StackPanel>

                        <Button Content="启动"
                                Command="{Binding LaunchCommand}"
                                IsEnabled="{Binding CanLaunch}"
                                Classes="primary"
                                Width="240"
                                Height="48"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0" />

                        <TextBlock Text="{Binding LaunchWarning}"
                                   Foreground="#D13438"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   IsVisible="{Binding HasLaunchWarning}" />
                </StackPanel>

                <!-- 顶部账号切换：叠加在原有布局上方，不影响中间内容的居中 -->
                <StackPanel VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4"
                            Margin="0,6,0,0">
                    <Button Classes="accountTab"
                            Classes.selected="{Binding IsOfflineAccount}"
                            Content="离线"
                            Command="{Binding UseOfflineAccountCommand}" />
                    <Button Classes="accountTab"
                            Classes.selected="{Binding IsMicrosoftAccount}"
                            Content="正版"
                            Command="{Binding UseMicrosoftAccountCommand}" />
                </StackPanel>

                <!-- 正版登录 -->
                <Border IsVisible="{Binding IsLoginDialogOpen}"
                        Background="#33000000">
                    <Border Width="420"
                            Padding="24"
                            CornerRadius="12"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel Spacing="12">
                            <TextBlock Text="正版登录" FontSize="18" FontWeight="SemiBold" />

                            <TextBlock Text="{Binding LoginStatusText}"
                                       FontSize="13"
                                       Opacity="0.75"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding LoginUserCode}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       LetterSpacing="2"
                                       HorizontalAlignment="Center" />

                            <TextBlock Text="{Binding LoginVerificationUri}"
                                       FontSize="12"
                                       Opacity="0.6"
                                       HorizontalAlignment="Center" />

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Right">
                                <Button Content="复制代码"
                                        Height="32"
                                        Padding="14,0"
                                        Click="OnCopyLoginCodeClick" />
                                <Button Content="打开链接"
                                        Height="32"
                                        Padding="14,0"
                                        Click="OnOpenLoginLinkClick" />
                                <Button Content="取消"
                                        Height="32"
                                        Padding="14,0"
                                        Command="{Binding CancelMicrosoftLoginCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- 版本 -->
            <Grid RowDefinitions="Auto,*" RowSpacing="12" IsVisible="{Binding IsVersionsSectionSelected}">

                <!-- 文件夹下拉 + 重新扫描 + 导入 -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding GameFolders}"
                              SelectedItem="{Binding SelectedGameFolder}"
                              HorizontalAlignment="Stretch"
                              MinHeight="34"
                              Padding="8,1"
                              ToolTip.Tip="{Binding SelectedGameFolder.Path}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameFolderItemViewModel">
                                <StackPanel Spacing="0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}"
                                               FontSize="10"
                                               Opacity="0.55"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="1"
                            Classes="soft"
                            Content="重新扫描"
                            Height="34"
                            Padding="12,0"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding !IsBusy}" />

                    <DropDownButton Grid.Column="2"
                                    Classes="soft"
                                    Content="导入"
                                    Height="34"
                                    Padding="14,0"
                                    IsEnabled="{Binding !IsBusy}">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="添加已有文件夹…" Click="OnAddGameFolderClick" />
                                <MenuItem Header="导入 PCL 启动器 (.exe)…" Click="OnChoosePclExecutableClick" />
                                <MenuItem Header="导入 PCL 文件夹 / 游戏目录…" Click="OnChoosePclFolderClick" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>

                <!-- 版本列表 + 信息 -->
                <Grid Grid.Row="1" ColumnDefinitions="260,1,*" ColumnSpacing="16">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="本地版本" Classes="section" FontSize="13" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding VersionsCountText}"
                                       FontSize="11"
                                       Opacity="0.6"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Versions}"
                                 SelectedItem="{Binding SelectedVersion}"
                                 Background="Transparent"
                                 Padding="0,0,14,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:VersionItemViewModel">
                                    <StackPanel Spacing="1" Margin="2,4">
                                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Column="1" Classes="vline" />

                    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                        <TextBlock Text="版本信息" Classes="section" />
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="0,0,12,0">
                            <TextBlock Text="{Binding VersionDetails}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                        <Grid Grid.Row="2" RowDefinitions="1,Auto" RowSpacing="10" Margin="0,2,0,0">
                            <Border Classes="hline" />
                            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                                <!-- 版本设置界面暂未实现，先保留空按钮 -->
                                <Button Classes="soft"
                                        Content="设置"
                                        Height="34"
                                        HorizontalAlignment="Stretch"
                                        FontSize="13" />
                                <Button Grid.Column="1"
                                        Classes="danger"
                                        Content="删除"
                                        Height="34"
                                        HorizontalAlignment="Stretch"
                                        FontSize="13"
                                        Command="{Binding RequestVersionDeleteCommand}"
                                        IsEnabled="{Binding CanManageSelectedVersion}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
