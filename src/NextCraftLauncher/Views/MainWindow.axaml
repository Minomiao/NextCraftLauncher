<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NextCraftLauncher.ViewModels"
        xmlns:views="using:NextCraftLauncher.Views"
        xmlns:controls="using:NextCraftLauncher.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="820"
        x:Class="NextCraftLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app.ico"
        Title="Next Craft Launcher"
        Width="900" Height="620"
        MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- 选中态只由共享指示器表达，按钮自身不再出现悬停/按下色块 -->
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.caption">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelFillHoverBrush}" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Button.caption:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelFillHoverBrush}" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <!-- 标题栏左侧：品牌与返回按钮，进场/退场动画由代码驱动 -->
        <Style Selector="TextBlock.brand">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.brandBack">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Styles>

    <Panel>
        <Grid x:Name="ContentRoot" RowDefinitions="Auto,*"
              Background="{DynamicResource PageBackgroundBrush}">

        <!-- 沉浸式标题栏：左侧品牌、居中导航，可拖动 -->
        <Grid Grid.Row="0"
              Height="52"
              Background="Transparent"
              PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="*,Auto,*" Margin="16,0,0,0">
                <Panel Height="52"
                       Width="150"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       ClipToBounds="True">
                    <TextBlock x:Name="BrandText"
                               Classes="brand"
                               Text="NEXT"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />

                    <Button x:Name="BrandBackButton"
                            Classes="soft brandBack"
                            Command="{Binding GoBackCommand}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <!-- 退出/返回图标：形状来自 Assets/Icons/Ui/back.svg -->
                        <controls:IconView Icon="back" />
                    </Button>
                </Panel>

                <Panel Grid.Column="1"
                       x:Name="NavBar"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <!-- 唯一的高亮指示器：位置与宽度由代码驱动，拖动时以指针为中心 -->
                    <Border x:Name="NavIndicator"
                            Width="0"
                            Height="32"
                            CornerRadius="16"
                            Background="{DynamicResource SoftButtonBrush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="50%,50%"
                            IsHitTestVisible="False">
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="nav"
                                x:Name="NavLaunchButton"
                                Content="启动"
                                Command="{Binding ShowLaunchPageCommand}" />
                        <Button Classes="nav"
                                x:Name="NavDownloadButton"
                                Content="下载"
                                Command="{Binding ShowDownloadPageCommand}" />
                        <Button Classes="nav"
                                x:Name="NavSettingsButton"
                                Content="设置"
                                Command="{Binding ShowSettingsPageCommand}" />
                    </StackPanel>
                </Panel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="2"
                            Margin="0,0,16,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Classes="caption"
                            ToolTip.Tip="最小化"
                            Click="OnMinimizeClick">
                        <controls:IconView Icon="minimize" />
                    </Button>
                    <Button Classes="caption"
                            ToolTip.Tip="关闭"
                            Click="OnCloseClick">
                        <controls:IconView Icon="close" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Height="1"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource DividerBrush}" />
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1" Margin="16,10,16,16">
            <views:LaunchView IsVisible="{Binding IsLaunchPageSelected}" />
            <views:DownloadView IsVisible="{Binding IsDownloadPageSelected}" />
            <views:SettingsView IsVisible="{Binding IsSettingsPageSelected}" />
        </Grid>
        </Grid>

        <!-- 删除版本确认弹窗 -->
        <Border IsVisible="{Binding IsVersionDeleteDialogOpen}"
                Background="{DynamicResource OverlayMaskBrush}">
            <Border Width="420"
                    Padding="24"
                    CornerRadius="12"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="删除版本" Classes="title" />
                    <TextBlock Text="{Binding VersionDeleteDialogMessage}"
                               Classes="bodyMuted"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Button Content="取消"
                                Height="32"
                                Padding="14,0"
                                Command="{Binding CancelVersionDeleteCommand}" />
                        <Button Content="不显示"
                                Height="32"
                                Padding="14,0"
                                Command="{Binding HideSelectedVersionCommand}" />
                        <Button Classes="danger"
                                Content="完全删除"
                                Height="32"
                                Padding="14,0"
                                Command="{Binding DeleteSelectedVersionCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 下载 / 安装错误弹窗（置顶，背景模糊）：Error 预设 -->
        <controls:MessageCard IsOpen="{Binding IsDownloadErrorDialogOpen}"
                              Kind="Error"
                              Title="{Binding DownloadErrorTitle}"
                              Message="{Binding DownloadErrorHint}"
                              CloseRequested="OnErrorDialogClose"
                              OpenLogRequested="OnErrorDialogOpenLog"
                              ExportRequested="OnErrorDialogExport" />

        <!-- 当前版本不能启动时的说明（Notice 预设） -->
        <controls:MessageCard IsOpen="{Binding IsLaunchNoticeOpen}"
                              Kind="Notice"
                              Title="{Binding LaunchNoticeTitle}"
                              Message="{Binding LaunchNoticeMessage}"
                              CloseRequested="OnLaunchNoticeClose" />
    </Panel>

</Window>
