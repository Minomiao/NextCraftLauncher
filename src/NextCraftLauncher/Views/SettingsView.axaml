<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NextCraftLauncher.ViewModels"
             xmlns:java="using:NextCraftLauncher.Core.Java"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
             x:Class="NextCraftLauncher.Views.SettingsView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- 分组眉标：比字段标签更小更淡，只用来切分段落 -->
        <Style Selector="TextBlock.group">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <Setter Property="Opacity" Value="0.56" />
        </Style>

        <!-- 分区之间的细分隔线 -->
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
            <Setter Property="Margin" Value="0,22" />
        </Style>

        <!-- 只读值：与下拉框同高同圆角的浅色块，不再是裸文字 -->
        <Style Selector="Border.readonly">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 主题色色块：圆形，选中时在外圈描一道边 -->
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.swatch:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.swatch:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.swatch.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="176,1,*" ColumnSpacing="16">

        <!-- 左侧边栏 -->
        <StackPanel Spacing="2" VerticalAlignment="Top" Margin="0,2,0,0">
            <Button Classes="side"
                    Classes.selected="{Binding IsSettingsLaunchSelected}"
                    Content="启动设置"
                    Command="{Binding ShowSettingsLaunchCommand}" />
            <Button Classes="side"
                    Classes.selected="{Binding IsSettingsDownloadSelected}"
                    Content="下载设置"
                    Command="{Binding ShowSettingsDownloadCommand}" />
            <Button Classes="side"
                    Classes.selected="{Binding IsSettingsAppearanceSelected}"
                    Content="外观"
                    Command="{Binding ShowSettingsAppearanceCommand}" />
        </StackPanel>


        <Grid Grid.Column="2">

            <!-- 启动设置 -->
            <ScrollViewer IsVisible="{Binding IsSettingsLaunchSelected}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Width="460" HorizontalAlignment="Left">

                    <TextBlock Text="启动设置" Classes="section" />

                    <StackPanel Spacing="12" Margin="0,18,0,0">
                        <TextBlock Text="窗口" Classes="group" />

                        <Grid ColumnDefinitions="96,*" ColumnSpacing="14">
                            <TextBlock Text="启动器可见性" Classes="fieldLabel" />
                            <ComboBox Grid.Column="1"
                                      Classes="toolbar"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding LauncherVisibilityOptions}"
                                      SelectedIndex="{Binding SelectedLauncherVisibilityIndex}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*" ColumnSpacing="14">
                            <TextBlock Text="进程优先级" Classes="fieldLabel" />
                            <ComboBox Grid.Column="1"
                                      Classes="toolbar"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding ProcessPriorityOptions}"
                                      SelectedIndex="{Binding SelectedProcessPriorityIndex}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*" ColumnSpacing="14">
                            <TextBlock Text="窗口大小" Classes="fieldLabel" />
                            <ComboBox Grid.Column="1"
                                      Classes="toolbar"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding WindowSizeOptions}"
                                      SelectedIndex="{Binding SelectedWindowSizeIndex}" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*" ColumnSpacing="14"
                              IsVisible="{Binding IsCustomWindowSize}">
                            <TextBlock Text="自定义尺寸" Classes="fieldLabel" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <NumericUpDown Value="{Binding CustomWindowWidth}"
                                               Minimum="320"
                                               Maximum="7680"
                                               Increment="10"
                                               FormatString="0"
                                               Width="120" />
                                <TextBlock Text="×" VerticalAlignment="Center" Opacity="0.4" />
                                <NumericUpDown Value="{Binding CustomWindowHeight}"
                                               Minimum="240"
                                               Maximum="4320"
                                               Increment="10"
                                               FormatString="0"
                                               Width="120" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Classes="divider" />

                    <StackPanel Spacing="12">
                        <TextBlock Text="内存与 Java" Classes="group" />

                        <Grid ColumnDefinitions="96,*" ColumnSpacing="14">
                            <TextBlock Text="内存 (MB)" Classes="fieldLabel" />
                            <ComboBox Grid.Column="1"
                                      Classes="toolbar"
                                      ItemsSource="{Binding MemoryOptions}"
                                      SelectedItem="{Binding MemoryMb}"
                                      HorizontalAlignment="Stretch" />
                        </Grid>

                        <Grid ColumnDefinitions="96,*" ColumnSpacing="14">
                            <TextBlock Text="Java" Classes="fieldLabel" />
                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ComboBox Classes="toolbar"
                                          ItemsSource="{Binding JavaRuntimes}"
                                          SelectedItem="{Binding SelectedJava}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="java:JavaRuntime">
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1"
                                        Classes="toolbar soft"
                                        Content="浏览"
                                        Click="OnBrowseJavaClick" />
                            </Grid>
                        </Grid>

                        <Grid ColumnDefinitions="96,*" ColumnSpacing="14">
                            <TextBlock Text="运行目录" Classes="fieldLabel" />
                            <Border Grid.Column="1"
                                    Classes="readonly"
                                    ToolTip.Tip="{Binding EffectiveGameDirectory}">
                                <TextBlock Text="{Binding EffectiveGameDirectory}"
                                           FontSize="11"
                                           Opacity="0.56"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 下载设置：各类列表的获取源（当前只影响显示） -->
            <ScrollViewer IsVisible="{Binding IsSettingsDownloadSelected}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Width="550" HorizontalAlignment="Left">

                    <TextBlock Text="下载设置" Classes="section" />

                    <StackPanel Spacing="12" Margin="0,18,0,0">
                        <TextBlock Text="清单来源"
                                   Classes="group"
                                   ToolTip.Tip="游戏版本源同时用于版本清单、游戏文件与 Java；加载器源只用于各自版本列表。" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <TextBlock Text="游戏版本" Classes="fieldLabel" />
                            <ComboBox Grid.Column="1"
                                      Classes="toolbar"
                                      Width="280"
                                      ItemsSource="{Binding DownloadMirrors}"
                                      SelectedIndex="{Binding SelectedGameMirrorIndex}"
                                      ToolTip.Tip="自动：在 Mojang 官方与镜像之间择快；也可固定为某个源。" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <TextBlock Text="Forge" Classes="fieldLabel" />
                            <ComboBox Grid.Column="1"
                                      Classes="toolbar"
                                      Width="280"
                                      ItemsSource="{Binding LoaderMirrorOptions}"
                                      SelectedIndex="{Binding SelectedForgeMirrorIndex}"
                                      ToolTip.Tip="自动：官网立即请求，镜像延迟对冲；也可固定为官网或镜像。" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <TextBlock Text="Fabric" Classes="fieldLabel" />
                            <ComboBox Grid.Column="1"
                                      Classes="toolbar"
                                      Width="280"
                                      ItemsSource="{Binding LoaderMirrorOptions}"
                                      SelectedIndex="{Binding SelectedFabricMirrorIndex}"
                                      ToolTip.Tip="自动：官网立即请求，镜像延迟对冲；也可固定为官网或镜像。" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <TextBlock Text="NeoForge" Classes="fieldLabel" />
                            <ComboBox Grid.Column="1"
                                      Classes="toolbar"
                                      Width="280"
                                      ItemsSource="{Binding LoaderMirrorOptions}"
                                      SelectedIndex="{Binding SelectedNeoForgeMirrorIndex}"
                                      ToolTip.Tip="自动：官网立即请求，镜像延迟对冲；也可固定为官网或镜像。" />
                        </Grid>
                    </StackPanel>

                    <Border Classes="divider" />

                    <StackPanel Spacing="12">
                        <TextBlock Text="版本隔离" Classes="group" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <TextBlock Text="默认策略" Classes="fieldLabel" />
                            <ComboBox Grid.Column="1"
                                      Classes="toolbar"
                                      Width="280"
                                      ItemsSource="{Binding IsolationOptions}"
                                      SelectedIndex="{Binding SelectedIsolationIndex}" />
                        </Grid>
                    </StackPanel>

                    <Border Classes="divider" />

                    <StackPanel Spacing="12">
                        <TextBlock Text="Mod" Classes="group" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <TextBlock Text="进入时默认显示"
                                       Classes="fieldLabel"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      Classes="toolbar"
                                      Width="280"
                                      ItemsSource="{Binding ModDefaultFilterOptions}"
                                      SelectedIndex="{Binding SelectedModDefaultFilterIndex}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <TextBlock Text="下载后自动打开文件夹"
                                       Classes="fieldLabel"
                                       VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          IsChecked="{Binding OpenFolderAfterModDownload}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="Mod 下载完成后，在文件管理器中打开并选中该文件。" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 外观：主题色 -->
            <ScrollViewer IsVisible="{Binding IsSettingsAppearanceSelected}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Width="550" HorizontalAlignment="Left">

                    <TextBlock Text="外观" Classes="section" />

                    <StackPanel Spacing="12" Margin="0,18,0,0">
                        <!-- 系统色：位于其他颜色上方，单独一行 -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="系统" Classes="group" />

                            <Button Classes="swatch"
                                    Classes.selected="{Binding SystemAccentOption.IsSelected}"
                                    Command="{Binding SystemAccentOption.SelectCommand}"
                                    ToolTip.Tip="{Binding SystemAccentOption.Name}"
                                    HorizontalAlignment="Left">
                                <Border Width="28"
                                        Height="28"
                                        CornerRadius="14"
                                        Background="{Binding SystemAccentOption.Brush}" />
                            </Button>
                        </StackPanel>

                        <TextBlock Text="主题色" Classes="group" />

                        <ItemsControl ItemsSource="{Binding AccentOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" ItemWidth="46" ItemHeight="46" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccentOptionViewModel">
                                    <Button Classes="swatch"
                                            Classes.selected="{Binding IsSelected}"
                                            Command="{Binding SelectCommand}"
                                            ToolTip.Tip="{Binding Name}">
                                        <Border Width="28"
                                                Height="28"
                                                CornerRadius="14"
                                                Background="{Binding Brush}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

</UserControl>
